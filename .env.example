# Docker Compose env vars for the CDMX Crime GIS app — template (copy to .env / .env.test / .env.prod)
#
# Activate with:
#   docker compose --env-file .env.example up -d --build
#
# The app-role DB password, the Gemini key and the MCP shared key are Docker
# SECRETS read from ./secrets/*.txt (db-setup.sh generates db_password.txt).

# ── Host UID/GID (must match the uid that owns ./secrets/*.txt) ─────────────
APP_UID=1000
APP_GID=1000

# ── Container names (unique on the shared intranet network) ─────────────────
BACKEND_CONTAINER_NAME=cdmx-crime-backend
FRONTEND_CONTAINER_NAME=cdmx-crime-frontend
MCP_CONTAINER_NAME=cdmx-crime-mcp

# ── Traefik routing ─────────────────────────────────────────────────────────
#CRIME_FRONTEND_HOST=crime.home.iktdts.com
#CRIME_MCP_HOST=crimemcp.home.iktdts.com
#CERT_RESOLVER=cloudflare

# ── Database (shared infra container at /home/iktdts/apps/infra/database) ──
POSTGRES_USER=crime_user
POSTGRES_DB=cdmx_crime
POSTGRES_HOST=postgres          # container name on the external dbnet
POSTGRES_SCHEMA=crime_user

# ── CORS / origins ──────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173

# ── Ingest ─────────────────────────────────────────────────────────────────
# 1 = run the idempotent ingest in the background on every boot (default).
# 0 = never ingest on boot; run `docker compose exec crime-backend python -m services.ingest`.
INGEST_ON_BOOT=1

# ── Chat / MCP ─────────────────────────────────────────────────────────────
# Secrets: secrets/gemini_api_key.txt, secrets/crime_mcp_api_key.txt.
# Empty key files → /api/chat/stream returns 503, everything else works.
CRIME_GEMINI_MODEL=gemini-2.5-flash
# Unique container names — bare aliases collide on the shared intranet.
CRIME_MCP_URL=http://${MCP_CONTAINER_NAME}:6701
CRIME_BACKEND_URL=http://${BACKEND_CONTAINER_NAME}:8000
MCP_LOG_LEVEL=INFO
